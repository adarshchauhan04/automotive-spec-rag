# ==============================================================================
# Vehicle Specification Extraction - Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# DO NOT COMMIT .env TO VERSION CONTROL.

# ------------------------------------------------------------------------------
# OPTION 1: Hugging Face Serverless (Free, using an active warm model)
# Get your token from: https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HF_TOKEN=hf_your_actual_token_here
HF_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ------------------------------------------------------------------------------
# OPTION 2: Official Mistral AI Platform (Free tier credits at console.mistral.ai)
# ------------------------------------------------------------------------------
# MISTRAL_API_KEY=your_mistral_api_key_here
# HF_MODEL_NAME=open-mistral-7b

# ------------------------------------------------------------------------------
# OPTION 3: Local Offline Mistral (Via Ollama - 100% free, runs on your PC)
# Install Ollama, then run: ollama run mistral
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# HF_MODEL_NAME=mistral

# ------------------------------------------------------------------------------
# Embedding Configuration (Local SentenceTransformers - runs 100% offline)
# ------------------------------------------------------------------------------
EMBEDDER_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
